@model FitStack.ViewModels.Wellness.WellnessViewModel
@{
    ViewData["Title"] = "Wellness";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .wellness-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    /* Stats Cards */
    .stats-grid-wellness {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card-wellness {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        border: 1px solid var(--border-color);
        transition: all 0.3s;
    }

        .stat-card-wellness:hover {
            transform: translateY(-5px);
        }

    .stat-icon-wellness {
        font-size: 32px;
        margin-bottom: 10px;
    }

    .stat-value-wellness {
        font-size: 24px;
        font-weight: 700;
        color: var(--primary);
    }

    .stat-label-wellness {
        font-size: 12px;
        color: var(--text-tertiary);
        margin-top: 5px;
    }

    /* Mood Tracker */
    .mood-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
        margin: 20px 0;
    }

    .mood-option {
        text-align: center;
        padding: 12px;
        background: var(--bg-tertiary);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
        border: 2px solid transparent;
    }

        .mood-option:hover {
            transform: scale(1.05);
            background: var(--bg-secondary);
        }

        .mood-option.selected {
            border-color: var(--primary);
            background: rgba(79, 70, 229, 0.1);
        }

    .mood-emoji {
        font-size: 28px;
        margin-bottom: 5px;
    }

    .mood-label {
        font-size: 12px;
        color: var(--text-secondary);
    }

    /* Water Tracker */
    .water-glasses {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 20px 0;
    }

    .water-glass {
        width: 60px;
        height: 80px;
        background: var(--bg-tertiary);
        border-radius: 0 0 30px 30px;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 10px;
        border: 2px solid var(--border-color);
        color: var(--text-tertiary);
    }

        .water-glass.active {
            background: linear-gradient(135deg, #3B82F6, #2563EB);
            color: white;
            border-color: #3B82F6;
            transform: scale(1.05);
        }

    /* Meditation Timer */
    .meditation-timer {
        text-align: center;
        padding: 20px;
        background: linear-gradient(135deg, #8B5CF6, #6D28D9);
        border-radius: 20px;
        color: white;
    }

    .timer-display {
        font-size: 48px;
        font-weight: 700;
        font-family: monospace;
        margin: 20px 0;
    }

    /* Mood History Chart */
    .mood-history {
        max-height: 300px;
        overflow-y: auto;
    }

    .mood-history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-bottom: 1px solid var(--border-color);
    }

    /* Sleep Tips */
    .sleep-tip {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        border-radius: 16px;
        padding: 20px;
    }

    @@media (max-width: 1024px) {
        .wellness-container {
            grid-template-columns: 1fr;
        }

        .stats-grid-wellness {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .stats-grid-wellness {
            grid-template-columns: 1fr;
        }

        .mood-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<div class="wellness-container">
    <!-- Left Column -->
    <div>
        <!-- Stats Overview -->
        <div class="stats-grid-wellness">
            <div class="stat-card-wellness">
                <div class="stat-icon-wellness">😴</div>
                <div class="stat-value-wellness">@Model.Metrics.SleepScore%</div>
                <div class="stat-label-wellness">Sleep Score</div>
            </div>
            <div class="stat-card-wellness">
                <div class="stat-icon-wellness">⚡</div>
                <div class="stat-value-wellness">@Model.Metrics.EnergyLevel%</div>
                <div class="stat-label-wellness">Energy Level</div>
            </div>
            <div class="stat-card-wellness">
                <div class="stat-icon-wellness">😰</div>
                <div class="stat-value-wellness">@Model.Metrics.StressLevel%</div>
                <div class="stat-label-wellness">Stress Level</div>
            </div>
            <div class="stat-card-wellness">
                <div class="stat-icon-wellness">❤️</div>
                <div class="stat-value-wellness">@Model.Metrics.HRV ms</div>
                <div class="stat-label-wellness">HRV</div>
            </div>
        </div>

        <!-- Mood Tracker -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-smile"></i> How are you feeling?
                </h3>
                <span class="card-link">Today's Mood: @Model.Metrics.Mood</span>
            </div>

            <div class="mood-grid">
                <div class="mood-option" onclick="selectMood('Great')">
                    <div class="mood-emoji">😄</div>
                    <div class="mood-label">Great</div>
                </div>
                <div class="mood-option" onclick="selectMood('Good')">
                    <div class="mood-emoji">😊</div>
                    <div class="mood-label">Good</div>
                </div>
                <div class="mood-option" onclick="selectMood('Okay')">
                    <div class="mood-emoji">😐</div>
                    <div class="mood-label">Okay</div>
                </div>
                <div class="mood-option" onclick="selectMood('Tired')">
                    <div class="mood-emoji">😴</div>
                    <div class="mood-label">Tired</div>
                </div>
                <div class="mood-option" onclick="selectMood('Stressed')">
                    <div class="mood-emoji">😰</div>
                    <div class="mood-label">Stressed</div>
                </div>
                <div class="mood-option" onclick="selectMood('Anxious')">
                    <div class="mood-emoji">😟</div>
                    <div class="mood-label">Anxious</div>
                </div>
            </div>

            <div class="form-group">
                <textarea class="form-input" id="moodNote" rows="2" placeholder="Add a note about how you're feeling..."></textarea>
            </div>

            <button class="btn-primary" onclick="logMood()" style="width: 100%;">
                <i class="fas fa-save"></i> Log Mood
            </button>
        </div>

        <!-- Water Intake Tracker -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tint"></i> Water Intake
                </h3>
                <span class="card-link">Goal: @Model.Metrics.WaterGoal glasses</span>
            </div>

            <div class="water-glasses" id="waterGlasses">
                @for (int i = 1; i <= 8; i++)
                {
                    <div class="water-glass @(i <= Model.Metrics.WaterIntake ? "active" : "")"
                         data-glass="@i" onclick="toggleWater(@i)">
                        @i
                    </div>
                }
            </div>

            <div style="text-align: center; margin-top: 15px;">
                <span id="waterCount">@Model.Metrics.WaterIntake</span> / @Model.Metrics.WaterGoal glasses consumed
            </div>
        </div>

        <!-- Daily Wellness Tips -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-lightbulb"></i> Daily Wellness Tips
                </h3>
            </div>

            <div style="display: grid; gap: 15px;">
                @foreach (var tip in Model.DailyTips)
                {
                    <div class="activity-item">
                        <div class="activity-icon">@tip.Icon</div>
                        <div class="activity-details">
                            <div class="activity-title">@tip.Title</div>
                            <div class="activity-meta">@tip.Description</div>
                        </div>
                        <span class="difficulty easy" style="font-size: 10px;">@tip.Category</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div>
        <!-- Meditation Timer -->
        <div class="card meditation-timer">
            <h3 style="margin-bottom: 15px;">
                <i class="fas fa-spa"></i> Meditation Session
            </h3>
            <div class="timer-display" id="timerDisplay">00:00</div>
            <div style="display: flex; gap: 10px; justify-content: center;">
                <button class="btn-primary" onclick="startMeditation()" id="startMedBtn">
                    <i class="fas fa-play"></i> Start
                </button>
                <button class="btn-outline" onclick="pauseMeditation()" id="pauseMedBtn" style="display: none;">
                    <i class="fas fa-pause"></i> Pause
                </button>
                <button class="btn-outline" onclick="resetMeditation()" id="resetMedBtn">
                    <i class="fas fa-stop"></i> Reset
                </button>
            </div>
            <div style="margin-top: 15px;">
                <button class="btn-outline" onclick="logMeditationSession()" style="width: 100%;">
                    <i class="fas fa-check"></i> Log Session
                </button>
            </div>
        </div>

        <!-- Sleep Quality -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-bed"></i> Sleep Quality
                </h3>
                <a href="#" class="card-link">Log Sleep →</a>
            </div>

            <div style="text-align: center;">
                <div style="font-size: 48px; font-weight: 700; color: var(--primary);">@Model.Metrics.SleepHours</div>
                <div style="color: var(--text-tertiary);">hours of sleep</div>

                <div class="progress-container" style="margin: 20px 0;">
                    <div class="progress-label">
                        <span>Sleep Quality</span>
                        <span>@Model.Metrics.SleepScore%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @Model.Metrics.SleepScore%"></div>
                    </div>
                </div>
            </div>

            <div class="sleep-tip" style="margin-top: 15px;">
                <i class="fas fa-info-circle"></i> Tip: Maintain a consistent sleep schedule for better recovery.
            </div>
        </div>

        <!-- Mood History -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-chart-line"></i> Mood History
                </h3>
                <a href="#" class="card-link">View All →</a>
            </div>

            <div class="mood-history">
                @foreach (var mood in Model.MoodHistory.OrderByDescending(m => m.Date).Take(7))
                {
                    <div class="mood-history-item">
                        <div>
                            <span style="font-size: 20px;">@mood.Emoji</span>
                            <span style="margin-left: 10px;">@mood.Mood</span>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-tertiary);">
                                @mood.Date.ToString("MMM dd")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Wellness Assessment -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clipboard-list"></i> Quick Wellness Check
                </h3>
            </div>

            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn-outline" onclick="takeAssessment()">
                    <i class="fas fa-heartbeat"></i> Stress Assessment
                </button>
                <button class="btn-outline" onclick="takeAssessment()">
                    <i class="fas fa-brain"></i> Mental Health Check
                </button>
                <button class="btn-outline" onclick="takeAssessment()">
                    <i class="fas fa-bed"></i> Sleep Quality Check
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let meditationInterval;
    let meditationSeconds = 0;
    let isMeditating = false;

    // Mood selection
    let selectedMood = null;

    function selectMood(mood) {
        selectedMood = mood;
        document.querySelectorAll('.mood-option').forEach(opt => {
            opt.classList.remove('selected');
        });
        event.currentTarget.classList.add('selected');
    }

    async function logMood() {
        const note = document.getElementById('moodNote').value;
        if (!selectedMood) {
            alert('Please select your mood first');
            return;
        }

        try {
            const response = await fetch('/Wellness/LogMood', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mood: selectedMood, note: note })
            });

            const result = await response.json();
            if (result.success) {
                alert('✅ Mood logged successfully!');
                document.getElementById('moodNote').value = '';
                selectedMood = null;
            }
        } catch (error) {
            console.error('Error logging mood:', error);
        }
    }

    // Water intake
    let waterIntake = @Model.Metrics.WaterIntake;

    function toggleWater(glassNumber) {
        const glass = document.querySelector(`.water-glass[data-glass='${glassNumber}']`);

        if (glass.classList.contains('active')) {
            glass.classList.remove('active');
            waterIntake--;
        } else {
            glass.classList.add('active');
            waterIntake++;
        }

        document.getElementById('waterCount').innerText = waterIntake;

        // Save to server
        fetch('/Wellness/LogWater', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount: waterIntake })
        });
    }

    // Meditation timer
    function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function updateTimerDisplay() {
        document.getElementById('timerDisplay').innerText = formatTime(meditationSeconds);
    }

    function startMeditation() {
        if (meditationInterval) clearInterval(meditationInterval);
        isMeditating = true;

        meditationInterval = setInterval(() => {
            if (isMeditating) {
                meditationSeconds++;
                updateTimerDisplay();
            }
        }, 1000);

        document.getElementById('startMedBtn').style.display = 'none';
        document.getElementById('pauseMedBtn').style.display = 'inline-block';
    }

    function pauseMeditation() {
        isMeditating = false;
        document.getElementById('startMedBtn').style.display = 'inline-block';
        document.getElementById('pauseMedBtn').style.display = 'none';
    }

    function resetMeditation() {
        clearInterval(meditationInterval);
        meditationSeconds = 0;
        isMeditating = false;
        updateTimerDisplay();
        document.getElementById('startMedBtn').style.display = 'inline-block';
        document.getElementById('pauseMedBtn').style.display = 'none';
    }

    async function logMeditationSession() {
        if (meditationSeconds === 0) {
            alert('Please meditate first before logging');
            return;
        }

        try {
            const response = await fetch('/Wellness/LogMeditation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ duration: meditationSeconds, type: 'Mindfulness' })
            });

            const result = await response.json();
            if (result.success) {
                alert(`✅ Logged ${formatTime(meditationSeconds)} of meditation!`);
                resetMeditation();
            }
        } catch (error) {
            console.error('Error logging meditation:', error);
        }
    }

    function takeAssessment() {
        alert("Wellness assessment coming soon! This will help track your overall wellness.");
    }

    // Load saved water intake from localStorage
    (function() {
        const savedWater = localStorage.getItem('waterIntake');
        if (savedWater) {
            waterIntake = parseInt(savedWater);
            document.getElementById('waterCount').innerText = waterIntake;
        }
    })();

    // Save water intake before leaving
    window.addEventListener('beforeunload', () => {
        localStorage.setItem('waterIntake', waterIntake);
    });
</script>