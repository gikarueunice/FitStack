@model FitStack.ViewModels.Dashboard.WeeklyProgressViewModel
@{
    ViewData["Title"] = "Progress";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .progress-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .progress-stat {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        border: 1px solid var(--border-color);
        transition: all 0.3s;
    }

        .progress-stat:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

    .stat-change {
        font-size: 14px;
        margin-top: 5px;
        font-weight: 500;
    }

    .positive {
        color: var(--secondary);
    }

    .negative {
        color: var(--danger);
    }

    .nutrition-value {
        font-size: 36px;
        font-weight: 700;
        color: var(--primary);
    }

    .nutrition-label {
        color: var(--text-tertiary);
        margin-top: 5px;
        font-size: 14px;
    }

    .chart-container {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 25px;
        border: 1px solid var(--border-color);
        transition: all 0.3s;
    }

        .chart-container:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .chart-title i {
            color: var(--primary);
        }

    /* Period Selector */
    .period-selector {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .period-btn {
        padding: 8px 16px;
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s;
        color: var(--text-secondary);
    }

        .period-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .period-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

    /* Additional Stats */
    .additional-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 25px;
    }

    .stat-detail {
        background: var(--bg-tertiary);
        border-radius: 15px;
        padding: 15px;
        text-align: center;
    }

    .stat-detail-label {
        font-size: 12px;
        color: var(--text-tertiary);
        margin-bottom: 5px;
    }

    .stat-detail-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--primary);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .progress-stats {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .nutrition-value {
            font-size: 28px;
        }

        .chart-container {
            padding: 15px;
        }

        .period-selector {
            justify-content: center;
        }

        .additional-stats {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .progress-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="progress-stats">
    <div class="progress-stat">
        <div class="stat-change positive">↑ 8%</div>
        <div class="nutrition-value">-3.2 kg</div>
        <div class="nutrition-label">Weight Loss</div>
    </div>
    <div class="progress-stat">
        <div class="stat-change positive">↑ 15%</div>
        <div class="nutrition-value">+5 kg</div>
        <div class="nutrition-label">Strength Gain</div>
    </div>
    <div class="progress-stat">
        <div class="stat-change positive">↑ 12%</div>
        <div class="nutrition-value">-4 cm</div>
        <div class="nutrition-label">Waist Size</div>
    </div>
    <div class="progress-stat">
        <div class="stat-change positive">↑ 20%</div>
        <div class="nutrition-value">+3 min</div>
        <div class="nutrition-label">Endurance</div>
    </div>
</div>

<div class="chart-container">
    <div class="chart-title">
        <i class="fas fa-chart-line"></i>
        Weight Progress (Last 3 Months)
    </div>
    <canvas id="weightChart" height="300"></canvas>
</div>

<div class="chart-container">
    <div class="chart-title">
        <i class="fas fa-calendar-check"></i>
        Workout Consistency
    </div>
    <div class="period-selector">
        <button class="period-btn active" onclick="changeChartPeriod('weekly')">Weekly</button>
        <button class="period-btn" onclick="changeChartPeriod('monthly')">Monthly</button>
        <button class="period-btn" onclick="changeChartPeriod('yearly')">Yearly</button>
    </div>
    <canvas id="workoutChart" height="300"></canvas>
</div>

<div class="additional-stats">
    <div class="stat-detail">
        <div class="stat-detail-label">Average Workout Duration</div>
        <div class="stat-detail-value">42 min</div>
    </div>
    <div class="stat-detail">
        <div class="stat-detail-label">Best Week</div>
        <div class="stat-detail-value">Week 2 (5 workouts)</div>
    </div>
    <div class="stat-detail">
        <div class="stat-detail-label">Total Calories Burned</div>
        <div class="stat-detail-value">12,450 cal</div>
    </div>
    <div class="stat-detail">
        <div class="stat-detail-label">Consistency Rate</div>
        <div class="stat-detail-value">85%</div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let weightChart;
    let workoutChart;
    let currentPeriod = 'weekly';

    // Get theme-aware colors
    function getChartColors() {
    const isDark = document.body.classList.contains('dark-mode');
    return {
    textColor: isDark ? '#F9FAFB' : '#1F2937',
    gridColor: isDark ? '#374151' : '#E5E7EB',
    weightBorderColor: '#4F46E5',
    weightBgColor: isDark ? 'rgba(79, 70, 229, 0.2)' : 'rgba(79, 70, 229, 0.1)',
    workoutColor: '#10B981'
    };
    }

    // Initialize Weight Chart
    function initWeightChart() {
    const ctx = document.getElementById('weightChart').getContext('2d');
    const colors = getChartColors();

    if (weightChart) {
    weightChart.destroy();
    }

    weightChart = new Chart(ctx, {
    type: 'line',
    data: {
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
    datasets: [{
    label: 'Weight (kg)',
    data: [82, 81, 79.5, 78.5, 78, 77.2],
    borderColor: colors.weightBorderColor,
    backgroundColor: colors.weightBgColor,
    borderWidth: 3,
    fill: true,
    tension: 0.4,
    pointBackgroundColor: colors.weightBorderColor,
    pointBorderColor: colors.weightBorderColor,
    pointRadius: 5,
    pointHoverRadius: 7
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
    legend: {
    labels: { color: colors.textColor }
    },
    tooltip: {
    backgroundColor: colors.gridColor,
    titleColor: colors.textColor,
    bodyColor: colors.textColor
    }
    },
    scales: {
    y: {
    ticks: { color: colors.textColor },
    grid: { color: colors.gridColor }
    },
    x: {
    ticks: { color: colors.textColor },
    grid: { color: colors.gridColor }
    }
    }
    }
    });
    }

    // Initialize Workout Chart
    function initWorkoutChart() {
    const ctx = document.getElementById('workoutChart').getContext('2d');
    const colors = getChartColors();

    let data, labels;

    switch(currentPeriod) {
    case 'weekly':
    labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    data = [4, 5, 6, 4, 5, 3, 2];
    break;
    case 'monthly':
    labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
    data = [4, 5, 3, 5];
    break;
    case 'yearly':
    labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    data = [4, 5, 6, 5, 7, 6, 8, 7, 9, 8, 10, 9];
    break;
    }

    if (workoutChart) {
    workoutChart.destroy();
    }

    workoutChart = new Chart(ctx, {
    type: 'bar',
    data: {
    labels: labels,
    datasets: [{
    label: 'Workouts Completed',
    data: data,
    backgroundColor: colors.workoutColor,
    borderRadius: 10,
    borderSkipped: false
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
    legend: {
    labels: { color: colors.textColor }
    },
    tooltip: {
    backgroundColor: colors.gridColor,
    titleColor: colors.textColor,
    bodyColor: colors.textColor
    }
    },
    scales: {
    y: {
    ticks: { color: colors.textColor },
    grid: { color: colors.gridColor },
    title: {
    display: true,
    text: 'Number of Workouts',
    color: colors.textColor
    }
    },
    x: {
    ticks: { color: colors.textColor },
    grid: { color: colors.gridColor }
    }
    }
    }
    });
    }

    // Change chart period
    function changeChartPeriod(period) {
    currentPeriod = period;

    // Update active button
    document.querySelectorAll('.period-btn').forEach(btn => {
    btn.classList.remove('active');
    });
    event.target.classList.add('active');

    initWorkoutChart();
    }

    // Update charts when theme changes
    function updateChartsForTheme() {
    initWeightChart();
    initWorkoutChart();
    }

    // Initialize charts on page load
    document.addEventListener('DOMContentLoaded', function() {
    initWeightChart();
    initWorkoutChart();

    // Listen for theme changes
    const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
    if (mutation.attributeName === 'class') {
    updateChartsForTheme();
    }
    });
    });

    observer.observe(document.body, { attributes: true });
    });
</script>