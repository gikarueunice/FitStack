<script>
    // Create post
    function createPost() {
        const postContent = document.getElementById('postContent').value;
        if (postContent.trim()) {
            alert("🎉 Post created successfully! Your fitness journey inspires others!");
            document.getElementById('postContent').value = '';
        } else {
            alert("Please write something before posting!");
        }
    }

    function addPhoto() {
        alert("📸 Add photo/video to your post - show off your progress!");
    }

    function addWorkout() {
        alert("🏋️ Share your workout details - inspire others with your routine!");
    }

    function addAchievement() {
        alert("🏆 Share your achievement - celebrate your wins!");
    }

    // Like post with counter
    function likePost(button, currentLikes) {
        const icon = button.querySelector('i');
        const isLiked = button.classList.contains('liked');

        if (!isLiked) {
            button.classList.add('liked');
            icon.classList.remove('far');
            icon.classList.add('fas');
            button.innerHTML = '<i class="fas fa-heart"></i> Liked';
            // Update like count in stats
            const statsDiv = button.closest('.post').querySelector('.post-stats');
            const likeSpan = statsDiv.querySelector('span:first-child');
            const newLikes = currentLikes + 1;
            likeSpan.innerHTML = `<i class="fas fa-heart"></i> ${newLikes} likes`;
        } else {
            button.classList.remove('liked');
            icon.classList.remove('fas');
            icon.classList.add('far');
            button.innerHTML = '<i class="far fa-heart"></i> Like';
            const statsDiv = button.closest('.post').querySelector('.post-stats');
            const likeSpan = statsDiv.querySelector('span:first-child');
            const newLikes = currentLikes - 1;
            likeSpan.innerHTML = `<i class="fas fa-heart"></i> ${newLikes} likes`;
        }
    }

    // Comment on post
    function commentPost(button) {
        const comment = prompt("💬 Write your comment:");
        if (comment && comment.trim()) {
            alert("✅ Comment posted successfully!");
            // Update comment count
            const statsDiv = button.closest('.post').querySelector('.post-stats');
            const commentSpan = statsDiv.querySelector('span:nth-child(2)');
            const currentComments = parseInt(commentSpan.innerHTML.match(/\d+/)[0]);
            commentSpan.innerHTML = `<i class="fas fa-comment"></i> ${currentComments + 1} comments`;
        }
    }

    function sharePost() {
        alert("🔗 Share link copied to clipboard! Inspire others with this post!");
    }

    function challengeFriend(friendId) {
        alert(`💪 Challenge sent to friend! Get ready to compete!`);
    }

    function viewChallenge(challengeName) {
        alert(`🎯 You've joined the "${challengeName}" challenge! Good luck!`);
    }

    function searchHashtag(hashtag) {
        alert(`🔍 Showing posts with ${hashtag}`);
    }

    function loadMorePosts() {
        alert("📱 Loading more posts from the community...");
    }
</script>