@{
    ViewData["Title"] = "Community";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .community-container {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 25px;
    }

    /* Social Feed Styles */
    .feed-card {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .create-post {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
    }

    .post-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary);
    }

    .post-input {
        flex: 1;
        padding: 15px;
        border: 1px solid var(--border-color);
        border-radius: 15px;
        resize: none;
        font-family: inherit;
        background: var(--bg-tertiary);
        color: var(--text-primary);
    }

        .post-input:focus {
            outline: none;
            border-color: var(--primary);
        }

    .post-actions {
        display: flex;
        gap: 15px;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid var(--border-color);
        flex-wrap: wrap;
    }

    .post-action {
        background: none;
        border: none;
        padding: 8px 16px;
        cursor: pointer;
        border-radius: 10px;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
    }

        .post-action:hover {
            background: var(--bg-tertiary);
            color: var(--primary);
        }

    /* Post Styles */
    .post {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s;
        border: 1px solid var(--border-color);
    }

        .post:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .post-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }

    .post-user-info {
        flex: 1;
    }

    .post-user-name {
        font-weight: 600;
        margin-bottom: 2px;
        color: var(--text-primary);
    }

    .post-time {
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .post-content {
        margin-bottom: 15px;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    .post-stats {
        display: flex;
        gap: 20px;
        padding: 12px 0;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .post-stat {
        font-size: 14px;
        color: var(--text-tertiary);
    }

    .post-interactions {
        display: flex;
        gap: 20px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .interaction-btn {
        background: none;
        border: none;
        padding: 8px 16px;
        cursor: pointer;
        border-radius: 10px;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-tertiary);
    }

        .interaction-btn.liked {
            color: var(--danger);
        }

        .interaction-btn:hover {
            background: var(--bg-tertiary);
            color: var(--primary);
        }

    /* Sidebar Styles */
    .sidebar-card {
        background: var(--bg-secondary);
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid var(--border-color);
        transition: all 0.3s;
    }

        .sidebar-card:hover {
            transform: translateY(-2px);
        }

    .sidebar-title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--border-color);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sidebar-title i {
            color: var(--primary);
        }

    .friend-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

        .friend-item:last-child {
            border-bottom: none;
        }

    .friend-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary);
    }

    .friend-info {
        flex: 1;
    }

    .friend-name {
        font-weight: 600;
        margin-bottom: 2px;
        color: var(--text-primary);
    }

    .friend-status {
        font-size: 12px;
        color: var(--secondary);
    }

    .friend-btn {
        padding: 6px 12px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
    }

        .friend-btn:hover {
            transform: scale(1.05);
        }

    .leaderboard-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

        .leaderboard-item:last-child {
            border-bottom: none;
        }

    .rank {
        width: 35px;
        font-weight: 700;
        font-size: 18px;
    }

        .rank.gold {
            color: #F59E0B;
        }

        .rank.silver {
            color: #9CA3AF;
        }

        .rank.bronze {
            color: #CD7F32;
        }

    .leaderboard-name {
        flex: 1;
        font-weight: 500;
        color: var(--text-primary);
    }

    .leaderboard-score {
        font-weight: 600;
        color: var(--primary);
    }

    /* Trending Hashtags */
    .hashtag {
        display: inline-block;
        padding: 6px 12px;
        background: var(--bg-tertiary);
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s;
        color: var(--text-secondary);
        font-size: 13px;
    }

        .hashtag:hover {
            background: var(--primary);
            color: white;
            transform: scale(1.05);
        }

    /* Responsive */
    @@media (max-width: 1024px) {
        .community-container {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .post-actions {
            justify-content: center;
        }

        .post-interactions {
            justify-content: center;
        }

        .create-post {
            flex-direction: column;
            align-items: center;
        }

        .post-input {
            width: 100%;
        }
    }
</style>

