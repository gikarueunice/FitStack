<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>@ViewData["Title"] - FitTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* Light Mode Variables (Default) */
            :root {
                --primary: #4F46E5;
                --primary-dark: #4338CA;
                --primary-light: #818CF8;
                --secondary: #10B981;
                --dark: #1F2937;
                --gray: #6B7280;
                --light-gray: #F3F4F6;
                --white: #FFFFFF;
                --error: #EF4444;
                --success: #10B981;
                --gradient: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
                /* Auth specific */
                --auth-bg: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
                --card-bg: #FFFFFF;
                --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
                --border-color: #E5E7EB;
                --input-bg: #FFFFFF;
                --input-border: #E5E7EB;
                --text-primary: #1F2937;
                --text-secondary: #4B5563;
                --text-muted: #6B7280;
                --divider-bg: #F3F4F6;
                --social-btn-border: #F3F4F6;
                --alert-success-bg: #ECFDF5;
                --alert-success-color: #065F46;
                --alert-error-bg: #FEF2F2;
                --alert-error-color: #991B1B;
                --alert-warning-bg: #FFFBEB;
                --alert-warning-color: #92400E;
                --alert-info-bg: #EFF6FF;
                --alert-info-color: #1E40AF;
            }

            /* Dark Mode - Automatic System Detection */
            @@media (prefers-color-scheme: dark) {
                :root {
                    --primary: #818CF8;
                    --primary-dark: #6366F1;
                    --primary-light: #A5B4FC;
                    --secondary: #34D399;
                    --dark: #F9FAFB;
                    --gray: #9CA3AF;
                    --light-gray: #374151;
                    --white: #1F2937;
                    --gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
                    /* Auth specific dark mode */
                    --auth-bg: linear-gradient(135deg, #1E1B4B 0%, #2E1065 100%);
                    --card-bg: #1F2937;
                    --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
                    --border-color: #374151;
                    --input-bg: #374151;
                    --input-border: #4B5563;
                    --text-primary: #F9FAFB;
                    --text-secondary: #E5E7EB;
                    --text-muted: #9CA3AF;
                    --divider-bg: #374151;
                    --social-btn-border: #374151;
                    --alert-success-bg: #064E3B;
                    --alert-success-color: #34D399;
                    --alert-error-bg: #7F1D1D;
                    --alert-error-color: #F87171;
                    --alert-warning-bg: #78350F;
                    --alert-warning-color: #FBBF24;
                    --alert-info-bg: #1E3A5F;
                    --alert-info-color: #60A5FA;
                }
            }

            /* Manual Dark Mode Override (for user preference) */
            body.dark-mode {
                --primary: #818CF8;
                --primary-dark: #6366F1;
                --primary-light: #A5B4FC;
                --secondary: #34D399;
                --dark: #F9FAFB;
                --gray: #9CA3AF;
                --light-gray: #374151;
                --white: #1F2937;
                --gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
                --auth-bg: linear-gradient(135deg, #1E1B4B 0%, #2E1065 100%);
                --card-bg: #1F2937;
                --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
                --border-color: #374151;
                --input-bg: #374151;
                --input-border: #4B5563;
                --text-primary: #F9FAFB;
                --text-secondary: #E5E7EB;
                --text-muted: #9CA3AF;
                --divider-bg: #374151;
                --social-btn-border: #374151;
                --alert-success-bg: #064E3B;
                --alert-success-color: #34D399;
                --alert-error-bg: #7F1D1D;
                --alert-error-color: #F87171;
                --alert-warning-bg: #78350F;
                --alert-warning-color: #FBBF24;
                --alert-info-bg: #1E3A5F;
                --alert-info-color: #60A5FA;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                background: var(--auth-bg);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                transition: background 0.3s ease;
            }

            .auth-container {
                width: 100%;
                max-width: 500px;
                margin: 0 auto;
            }

            .auth-card {
                background: var(--card-bg);
                border-radius: 24px;
                box-shadow: var(--card-shadow);
                padding: 40px;
                animation: slideUp 0.5s ease-out;
                transition: background 0.3s ease, box-shadow 0.3s ease;
                border: 1px solid var(--border-color);
            }

            .auth-header {
                text-align: center;
                margin-bottom: 32px;
            }

            .auth-logo {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                margin-bottom: 24px;
            }

                .auth-logo span {
                    font-size: 1.5rem;
                    font-weight: 700;
                    color: var(--text-primary);
                    transition: color 0.3s ease;
                }

            .auth-header h1 {
                font-size: 2rem;
                font-weight: 700;
                margin-bottom: 8px;
                color: var(--text-primary);
            }

            .auth-header p {
                color: var(--text-muted);
                font-size: 1rem;
            }

            /* Alert Styles */
            .alert {
                padding: 16px;
                border-radius: 12px;
                margin-bottom: 20px;
                display: flex;
                align-items: flex-start;
                gap: 12px;
                animation: slideIn 0.3s ease-out;
                position: relative;
            }

            .alert-dismissible {
                padding-right: 40px;
            }

            .alert-icon {
                font-size: 20px;
                flex-shrink: 0;
            }

            .alert-message {
                flex: 1;
                font-size: 0.95rem;
                line-height: 1.5;
                color: inherit;
            }

                .alert-message a {
                    color: inherit;
                    text-decoration: underline;
                    font-weight: 600;
                }

                    .alert-message a:hover {
                        text-decoration: none;
                    }

            .alert-close {
                position: absolute;
                top: 12px;
                right: 12px;
                background: none;
                border: none;
                font-size: 24px;
                cursor: pointer;
                color: inherit;
                opacity: 0.6;
                transition: opacity 0.3s;
                line-height: 1;
            }

                .alert-close:hover {
                    opacity: 1;
                }

            .alert-success {
                background: var(--alert-success-bg);
                color: var(--alert-success-color);
                border-left: 4px solid var(--secondary);
            }

            .alert-error {
                background: var(--alert-error-bg);
                color: var(--alert-error-color);
                border-left: 4px solid var(--error);
            }

            .alert-warning {
                background: var(--alert-warning-bg);
                color: var(--alert-warning-color);
                border-left: 4px solid #F59E0B;
            }

            .alert-info {
                background: var(--alert-info-bg);
                color: var(--alert-info-color);
                border-left: 4px solid #3B82F6;
            }

            /* Loading State for Buttons */
            .btn-submit:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }

            .btn-loader {
                display: inline-block;
                animation: spin 1s linear infinite;
            }

            @@keyframes spin {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            /* Registration Progress */
            .registration-progress {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 40px;
            }

            .progress-step {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
            }

            .step-number {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: var(--divider-bg);
                color: var(--text-muted);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                transition: all 0.3s;
            }

            .progress-step.active .step-number {
                background: var(--gradient);
                color: white;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

            .progress-step.completed .step-number {
                background: var(--secondary);
                color: white;
            }

                .progress-step.completed .step-number::after {
                    content: "✓";
                    font-size: 1.2rem;
                }

            .step-label {
                font-size: 0.85rem;
                font-weight: 500;
                color: var(--text-muted);
            }

            .progress-step.active .step-label {
                color: var(--primary);
                font-weight: 600;
            }

            .progress-line {
                flex: 1;
                height: 2px;
                background: var(--divider-bg);
                margin: 0 10px;
            }

            /* Form Steps */
            .form-step {
                display: none;
            }

                .form-step.active {
                    display: block;
                    animation: fadeIn 0.5s ease-out;
                }

            /* Form Elements */
            .form-group {
                margin-bottom: 20px;
            }

            .form-row {
                display: flex;
                gap: 15px;
                margin-bottom: 0;
            }

            .form-group.half {
                flex: 1;
            }

            .form-label {
                display: block;
                margin-bottom: 8px;
                font-weight: 500;
                color: var(--text-secondary);
                font-size: 0.95rem;
            }

            .input-group {
                display: flex;
                align-items: center;
                border: 2px solid var(--input-border);
                border-radius: 12px;
                transition: all 0.3s;
                background: var(--input-bg);
            }

                .input-group:focus-within {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
                }

            .input-icon {
                padding: 0 12px;
                color: var(--text-muted);
                font-size: 1.2rem;
            }

            .form-input {
                flex: 1;
                padding: 14px 12px 14px 0;
                border: none;
                background: transparent;
                font-size: 1rem;
                font-family: inherit;
                outline: none;
                color: var(--text-primary);
            }

                .form-input::placeholder {
                    color: var(--text-muted);
                }

            select.form-input {
                cursor: pointer;
                color: var(--text-primary);
            }

                select.form-input option {
                    background: var(--card-bg);
                    color: var(--text-primary);
                }

            .password-toggle {
                background: none;
                border: none;
                padding: 0 12px;
                cursor: pointer;
                font-size: 1.2rem;
                color: var(--text-muted);
            }

            /* Password Strength */
            .password-strength {
                display: flex;
                gap: 5px;
                margin-top: 8px;
            }

            .strength-bar {
                height: 4px;
                flex: 1;
                background: var(--divider-bg);
                border-radius: 4px;
                transition: all 0.3s;
            }

            .password-requirements {
                list-style: none;
                margin-top: 8px;
                font-size: 0.85rem;
            }

                .password-requirements li {
                    color: var(--text-muted);
                    margin-bottom: 4px;
                    transition: color 0.3s;
                }

            /* Checkbox */
            .checkbox-container {
                display: flex;
                align-items: center;
                position: relative;
                cursor: pointer;
                font-size: 0.95rem;
                user-select: none;
            }

                .checkbox-container input {
                    position: absolute;
                    opacity: 0;
                    cursor: pointer;
                    height: 0;
                    width: 0;
                }

            .checkmark {
                position: relative;
                height: 20px;
                width: 20px;
                background: var(--input-bg);
                border: 2px solid var(--input-border);
                border-radius: 6px;
                margin-right: 10px;
                transition: all 0.3s;
            }

            .checkbox-container:hover input ~ .checkmark {
                border-color: var(--primary);
            }

            .checkbox-container input:checked ~ .checkmark {
                background: var(--primary);
                border-color: var(--primary);
            }

            .checkmark:after {
                content: "";
                position: absolute;
                display: none;
            }

            .checkbox-container input:checked ~ .checkmark:after {
                display: block;
            }

            .checkbox-container .checkmark:after {
                left: 6px;
                top: 2px;
                width: 5px;
                height: 10px;
                border: solid white;
                border-width: 0 2px 2px 0;
                transform: rotate(45deg);
            }

            .checkbox-label {
                flex: 1;
                color: var(--text-muted);
            }

                .checkbox-label a {
                    color: var(--primary);
                    text-decoration: none;
                    font-weight: 500;
                }

                    .checkbox-label a:hover {
                        text-decoration: underline;
                    }

            /* Goal Cards */
            .goal-options {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
                margin-top: 10px;
            }

            .goal-card {
                position: relative;
                cursor: pointer;
            }

                .goal-card input {
                    position: absolute;
                    opacity: 0;
                }

            .goal-content {
                padding: 20px 15px;
                border: 2px solid var(--input-border);
                border-radius: 12px;
                text-align: center;
                transition: all 0.3s;
                background: var(--card-bg);
            }

            .goal-card input:checked + .goal-content {
                border-color: var(--primary);
                background: rgba(79, 70, 229, 0.1);
                transform: scale(1.02);
            }

            .goal-emoji {
                font-size: 2rem;
                margin-bottom: 8px;
                display: block;
            }

            .goal-title {
                font-weight: 600;
                margin-bottom: 4px;
                display: block;
                color: var(--text-primary);
            }

            .goal-desc {
                font-size: 0.85rem;
                color: var(--text-muted);
            }

            /* Buttons */
            .btn-next, .btn-prev, .btn-submit {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 12px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s;
                margin-top: 10px;
            }

            .btn-next, .btn-submit {
                background: var(--gradient);
                color: white;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

                .btn-next:hover, .btn-submit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.4);
                }

            .btn-prev {
                background: var(--divider-bg);
                color: var(--text-primary);
            }

                .btn-prev:hover {
                    background: var(--border-color);
                }

            .form-buttons {
                display: flex;
                gap: 10px;
                margin-top: 20px;
            }

                .form-buttons .btn-prev,
                .form-buttons .btn-next,
                .form-buttons .btn-submit {
                    width: auto;
                    flex: 1;
                    margin-top: 0;
                }

            /* Form Options (Login) */
            .form-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }

            .forgot-password {
                color: var(--primary);
                text-decoration: none;
                font-size: 0.95rem;
                font-weight: 500;
            }

                .forgot-password:hover {
                    text-decoration: underline;
                }

            /* Validation Error */
            .validation-error {
                color: var(--error);
                font-size: 0.85rem;
                margin-top: 4px;
                display: block;
            }

            /* Social Registration */
            .social-registration {
                margin-top: 30px;
            }

            .divider {
                position: relative;
                text-align: center;
                margin: 20px 0;
            }

                .divider::before,
                .divider::after {
                    content: "";
                    position: absolute;
                    top: 50%;
                    width: calc(50% - 70px);
                    height: 1px;
                    background: var(--divider-bg);
                }

                .divider::before {
                    left: 0;
                }

                .divider::after {
                    right: 0;
                }

                .divider span {
                    background: var(--card-bg);
                    padding: 0 10px;
                    color: var(--text-muted);
                    font-size: 0.9rem;
                }

            .social-buttons {
                display: flex;
                gap: 10px;
            }

            .social-btn {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px;
                border: 2px solid var(--social-btn-border);
                border-radius: 12px;
                background: var(--card-bg);
                color: var(--text-primary);
                font-weight: 500;
                cursor: pointer;
                transition: all 0.3s;
            }

                .social-btn:hover {
                    border-color: var(--primary);
                    transform: translateY(-2px);
                }

                .social-btn img {
                    width: 18px;
                    height: 18px;
                }

            .apple-icon {
                font-size: 1.5rem;
                line-height: 1;
            }

            .facebook-icon {
                font-weight: 800;
                color: #1877F2;
            }

            /* Auth Footer */
            .auth-footer {
                text-align: center;
                margin-top: 30px;
                padding-top: 20px;
                border-top: 2px solid var(--divider-bg);
            }

                .auth-footer p {
                    color: var(--text-muted);
                }

                .auth-footer a {
                    color: var(--primary);
                    text-decoration: none;
                    font-weight: 600;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            /* Phone Number Field Styles */
            .field-tooltip {
                display: inline-block;
                margin-left: 5px;
                cursor: help;
                color: var(--text-muted);
                font-size: 14px;
            }

            .field-hint {
                margin-top: 5px;
                color: var(--text-muted);
                font-size: 12px;
            }

            .phone-format-btn {
                background: none;
                border: none;
                padding: 0 12px;
                cursor: pointer;
                font-size: 1.2rem;
                color: var(--text-muted);
                transition: color 0.3s;
            }

                .phone-format-btn:hover {
                    color: var(--primary);
                }

            /* Phone number validation styles */
            input#phoneNumber:valid {
                border-color: var(--secondary);
            }

            input#phoneNumber:invalid:not(:placeholder-shown) {
                border-color: var(--error);
            }

            /* Modal Styles */
            .modal {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 2000;
            }

            .modal-content {
                background: var(--card-bg);
                border-radius: 20px;
                max-width: 400px;
                width: 90%;
                animation: slideIn 0.3s ease-out;
                border: 1px solid var(--border-color);
            }

            .modal-header {
                padding: 20px;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .modal-header h3 {
                    color: var(--text-primary);
                }

            .modal-close {
                background: none;
                border: none;
                font-size: 24px;
                cursor: pointer;
                color: var(--text-muted);
            }

            .modal-body {
                padding: 20px;
            }

            .otp-target {
                font-weight: 600;
                color: var(--primary);
                margin: 10px 0;
                word-break: break-all;
            }

            .btn-link {
                background: none;
                border: none;
                color: var(--primary);
                cursor: pointer;
                text-decoration: underline;
                margin-top: 10px;
            }

            .timer {
                font-size: 14px;
                color: var(--text-muted);
                margin-top: 8px;
                text-align: center;
            }

            /* Phone verification badges */
            .phone-verified-badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: var(--alert-success-bg);
                color: var(--alert-success-color);
                padding: 4px 8px;
                border-radius: 20px;
                font-size: 12px;
                margin-left: 10px;
            }

            .phone-unverified-badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: var(--alert-error-bg);
                color: var(--alert-error-color);
                padding: 4px 8px;
                border-radius: 20px;
                font-size: 12px;
                margin-left: 10px;
                cursor: pointer;
            }

                .phone-unverified-badge:hover {
                    filter: brightness(0.9);
                }

            /* Animations */
            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(-50px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            /* Responsive */
            @@media (max-width: 480px) {
                .auth-card {
                    padding: 24px;
                }

                .form-row {
                    flex-direction: column;
                    gap: 0;
                }

                .goal-options {
                    grid-template-columns: 1fr;
                }

                .social-buttons {
                    flex-direction: column;
                }

                .progress-step .step-label {
                    display: none;
                }

                .registration-progress {
                    justify-content: center;
                }

                .form-options {
                    flex-direction: column;
                    gap: 10px;
                    align-items: flex-start;
                }
            }
    </style>
</head>
<body>
    @RenderBody()
    @RenderSection("Scripts", required: false)

    <script>
            // Complete Theme Management for Auth Pages
            (function() {
                try {
                    // Function to apply theme
                    function applyTheme(isDark) {
                        if (isDark) {
                            document.body.classList.add('dark-mode');
                        } else {
                            document.body.classList.remove('dark-mode');
                        }
                    }

                    // Get saved preference or system preference
                    const savedTheme = localStorage.getItem('userTheme');

                    if (savedTheme === 'dark') {
                        applyTheme(true);
                    } else if (savedTheme === 'light') {
                        applyTheme(false);
                    } else {
                        // Follow system preference
                        const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
                        applyTheme(darkModeMediaQuery.matches);

                        // Listen for system theme changes
                        if (darkModeMediaQuery.addEventListener) {
                            darkModeMediaQuery.addEventListener('change', (e) => {
                                const userTheme = localStorage.getItem('userTheme');
                                if (!userTheme || userTheme === 'system') {
                                    applyTheme(e.matches);
                                }
                            });
                        } else if (darkModeMediaQuery.addListener) {
                            // For older Safari
                            darkModeMediaQuery.addListener((e) => {
                                const userTheme = localStorage.getItem('userTheme');
                                if (!userTheme || userTheme === 'system') {
                                    applyTheme(e.matches);
                                }
                            });
                        }
                    }

                    console.log('Theme initialized for auth page');
                } catch (ex) {
                    console.error('Theme init error', ex);
                }
            })();
    </script>
</body>
</html>