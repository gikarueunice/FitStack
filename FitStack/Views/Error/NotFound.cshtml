@{
    ViewData["Title"] = "Page Not Found - FitTrack";
    Layout = null;

    // Check if user is authenticated
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .error-container {
                max-width: 600px;
                width: 100%;
                animation: fadeInUp 0.6s ease-out;
            }

            .error-card {
                background: white;
                border-radius: 32px;
                padding: 60px 40px;
                text-align: center;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            }

            .error-code {
                font-size: 120px;
                font-weight: 800;
                background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                line-height: 1;
                margin-bottom: 20px;
            }

            .error-icon {
                font-size: 80px;
                margin-bottom: 20px;
                animation: bounce 2s ease-in-out infinite;
            }

            .error-title {
                font-size: 28px;
                font-weight: 700;
                color: #1F2937;
                margin-bottom: 12px;
            }

            .error-message {
                font-size: 16px;
                color: #6B7280;
                margin-bottom: 30px;
                line-height: 1.6;
            }

            /* Countdown Timer Styles */
            .countdown-container {
                background: #F3F4F6;
                border-radius: 60px;
                padding: 8px;
                margin: 30px 0;
                display: inline-flex;
                align-items: center;
                gap: 15px;
            }

            .countdown-circle {
                width: 60px;
                height: 60px;
                background: linear-gradient(135deg, #4F46E5, #7C3AED);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
                font-weight: 700;
            }

            .countdown-text {
                font-size: 16px;
                color: #4B5563;
                padding-right: 20px;
            }

                .countdown-text strong {
                    color: #4F46E5;
                    font-size: 20px;
                }

            /* Progress Bar */
            .progress-bar-container {
                width: 100%;
                height: 4px;
                background: #E5E7EB;
                border-radius: 4px;
                margin: 20px 0;
                overflow: hidden;
            }

            .progress-bar-fill {
                height: 100%;
                background: linear-gradient(90deg, #4F46E5, #7C3AED);
                border-radius: 4px;
                transition: width 1s linear;
                width: 0%;
            }

            /* Buttons */
            .error-actions {
                display: flex;
                gap: 16px;
                justify-content: center;
                margin-bottom: 30px;
                flex-wrap: wrap;
            }

            .btn-primary, .btn-secondary, .btn-outline {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 24px;
                border-radius: 12px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.3s;
                cursor: pointer;
                border: none;
            }

            .btn-primary {
                background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
                color: white;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.4);
                }

            .btn-secondary {
                background: #F3F4F6;
                color: #4F46E5;
            }

                .btn-secondary:hover {
                    background: #E5E7EB;
                    transform: translateY(-2px);
                }

            .btn-outline {
                background: transparent;
                border: 2px solid #4F46E5;
                color: #4F46E5;
            }

                .btn-outline:hover {
                    background: #4F46E5;
                    color: white;
                    transform: translateY(-2px);
                }

            /* Login Required Message */
            .login-required {
                background: #FEF2F2;
                border: 1px solid #FECACA;
                border-radius: 12px;
                padding: 12px;
                margin-top: 15px;
                font-size: 14px;
                color: #991B1B;
                display: none;
            }

                .login-required.show {
                    display: block;
                    animation: shake 0.5s ease-in-out;
                }

            @@keyframes shake {
                0%, 100% {
                    transform: translateX(0);
                }

                25% {
                    transform: translateX(-5px);
                }

                75% {
                    transform: translateX(5px);
                }
            }

            /* Suggestions */
            .suggestions {
                text-align: left;
                background: #F9FAFB;
                padding: 20px;
                border-radius: 16px;
                margin-bottom: 30px;
            }

                .suggestions h4 {
                    font-size: 16px;
                    font-weight: 600;
                    color: #1F2937;
                    margin-bottom: 12px;
                }

                .suggestions ul {
                    list-style: none;
                    padding: 0;
                }

                .suggestions li {
                    padding: 8px 0;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #6B7280;
                }

                    .suggestions li a {
                        color: #4F46E5;
                        text-decoration: none;
                    }

                        .suggestions li a:hover {
                            text-decoration: underline;
                        }

            /* Footer */
            .footer {
                margin-top: 30px;
                font-size: 12px;
                color: rgba(255, 255, 255, 0.7);
                text-align: center;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes bounce {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-20px);
                }
            }

            @@media (max-width: 480px) {
                .error-card {
                    padding: 40px 24px;
                }

                .error-code {
                    font-size: 80px;
                }

                .error-title {
                    font-size: 24px;
                }

                .countdown-circle {
                    width: 50px;
                    height: 50px;
                    font-size: 20px;
                }

                .error-actions {
                    flex-direction: column;
                }

                .btn-primary, .btn-secondary, .btn-outline {
                    justify-content: center;
                }
            }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-card">
            <div class="error-icon">🔍</div>
            <div class="error-code">404</div>
            <h1 class="error-title">Oops! Page Not Found</h1>
            <p class="error-message">
                The page you're looking for seems to have wandered off during a workout.<br>
                Don't worry, even the best fitness journeys have a few wrong turns.
            </p>

            <!-- Countdown Timer -->
            <div class="countdown-container">
                <div class="countdown-circle" id="countdownNumber">5</div>
                <div class="countdown-text">
                    Redirecting you back in <strong id="countdownSeconds">5</strong> seconds
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="progress-bar-container">
                <div class="progress-bar-fill" id="progressBar"></div>
            </div>

            <!-- Buttons - Conditional based on authentication -->
            <div class="error-actions">
                <button onclick="goBack()" class="btn-primary">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="margin-right: 8px;">
                        <path d="M15 10H5M5 10L10 5M5 10L10 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Go Back
                </button>

                @if (isAuthenticated)
                {
                    <a href="/dashboard" class="btn-secondary">
                        <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                    </a>
                }
                else
                {
                    <button onclick="showLoginRequired()" class="btn-outline">
                        <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                    </button>
                }
            </div>

            <!-- Login Required Message -->
            <div id="loginRequiredMessage" class="login-required">
                <i class="fas fa-exclamation-triangle"></i>
                Please <a href="/auth/login" style="color: #991B1B; font-weight: 600;">login</a> or
                <a href="/auth/register" style="color: #991B1B; font-weight: 600;">create an account</a> to access the dashboard.
            </div>

            <!-- Helpful Suggestions -->
            <div class="suggestions">
                <h4>💡 While you wait, try these:</h4>
                <ul>
                    @if (isAuthenticated)
                    {
                        <li>
                            <span>🏠</span>
                            <a href="/dashboard">Go to your dashboard</a>
                        </li>
                        <li>
                            <span>🏋️</span>
                            <a href="/dashboard/workoutplan">View your workout plans</a>
                        </li>
                        <li>
                            <span>🏆</span>
                            <a href="/dashboard/challenges">Check active challenges</a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <span>🔑</span>
                            <a href="/auth/login">Login to your account</a>
                        </li>
                        <li>
                            <span>📝</span>
                            <a href="/auth/register">Create a free account</a>
                        </li>
                        <li>
                            <span>🏠</span>
                            <a href="/">Return to homepage</a>
                        </li>
                    }
                    <li>
                        <span>📞</span>
                        <a href="/contact">Contact support</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer">
            <p>&copy; 2026 FitTrack - Get back on track with your fitness goals</p>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
            // Get the previous page URL
            let previousPage = document.referrer;
            let countdown = 5;
            let countdownInterval;
            let progressInterval;
            let isAuthenticated = @(isAuthenticated ? "true" : "false");

            // Start countdown
            function startCountdown() {
                countdownInterval = setInterval(() => {
                    countdown--;

                    // Update countdown display
                    document.getElementById('countdownNumber').textContent = countdown;
                    document.getElementById('countdownSeconds').textContent = countdown;

                    // Update progress bar
                    const progressPercent = ((5 - countdown) / 5) * 100;
                    const progressBar = document.getElementById('progressBar');
                    progressBar.style.width = `${progressPercent}%`;

                    // When countdown reaches 0, go back
                    if (countdown <= 0) {
                        clearInterval(countdownInterval);
                        clearInterval(progressInterval);
                        goBack();
                    }
                }, 1000);
            }

            // Go back function
            function goBack() {
                if (previousPage && previousPage !== '') {
                    window.location.href = previousPage;
                } else {
                    // If no previous page, redirect based on auth status
                    if (isAuthenticated) {
                        window.location.href = '/dashboard';
                    } else {
                        window.location.href = '/';
                    }
                }
            }

            // Show login required message for non-authenticated users
            function showLoginRequired() {
                const messageDiv = document.getElementById('loginRequiredMessage');
                messageDiv.classList.add('show');

                // Auto hide after 5 seconds
                setTimeout(() => {
                    messageDiv.classList.remove('show');
                }, 5000);
            }

            // Animate progress bar
            function animateProgressBar() {
                let width = 0;
                progressInterval = setInterval(() => {
                    if (width >= 100) {
                        clearInterval(progressInterval);
                    } else {
                        width += 20;
                        document.getElementById('progressBar').style.width = `${width}%`;
                    }
                }, 1000);
            }

            // Initialize the page
            document.addEventListener('DOMContentLoaded', function() {
                startCountdown();
                animateProgressBar();

                // Random fitness tip
                const tips = [
                    "Even the best athletes miss their mark sometimes. What matters is getting back up!",
                    "Consider this a rest day for your browsing muscles.",
                    "Why not do 10 jumping jacks while you wait?",
                    "This page might be taking a water break. Try again in a moment.",
                    "404 not found, but your motivation is still 100%!",
                    "Every rep counts, even the ones that don't go as planned.",
                    "Take a deep breath and stretch for 30 seconds.",
                    "Drink some water while we find your page."
                ];

                const randomTip = tips[Math.floor(Math.random() * tips.length)];
                const tipElement = document.createElement('div');
                tipElement.style.cssText = 'background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); padding: 12px; border-radius: 12px; margin-top: 16px; font-size: 14px; color: #92400E;';
                tipElement.innerHTML = `💪 <strong>Daily Fitness Tip:</strong> ${randomTip}`;

                const suggestions = document.querySelector('.suggestions');
                if (suggestions) {
                    suggestions.insertAdjacentElement('afterend', tipElement);
                }
            });
    </script>
</body>
</html>