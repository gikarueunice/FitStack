@model FitStack.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <a href="/" class="auth-logo">
                <svg width="40" height="40" viewBox="0 0 32 32" fill="none">
                    <path d="M16 2L4 8V16C4 23.5 9.5 30.5 16 32C22.5 30.5 28 23.5 28 16V8L16 2Z" fill="#4F46E5" stroke="#6366F1" stroke-width="2" />
                    <path d="M12 16L15 19L21 13" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>FitTrack</span>
            </a>
            <h1>Welcome back!</h1>
            <p>Sign in to continue your fitness journey</p>
        </div>

        <!-- Alert Messages -->
        <div id="alertContainer">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <span class="alert-icon">✅</span>
                    <span class="alert-message">@Html.Raw(TempData["Success"])</span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error alert-dismissible">
                    <span class="alert-icon">❌</span>
                    <span class="alert-message">@Html.Raw(TempData["Error"])</span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible">
                    <span class="alert-icon">⚠️</span>
                    <span class="alert-message">@Html.Raw(TempData["Warning"]?.ToString())</span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible">
                    <span class="alert-icon">ℹ️</span>
                    <span class="alert-message">@Html.Raw(TempData["Info"])</span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
        </div>

        <!-- Login Form -->
        <form asp-action="Login" method="post" class="auth-form" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-icon">📧</span>
                    <input asp-for="Email" class="form-input" type="email" placeholder="you@example.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-icon">🔒</span>
                    <input asp-for="Password" class="form-input" type="password" placeholder="Enter your password" id="password" />
                    <button type="button" class="password-toggle" onclick="togglePassword('password')">👁️</button>
                </div>
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>

            <div class="form-options">
                <label class="checkbox-container">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span class="checkmark"></span>
                    <span class="checkbox-label">Remember me</span>
                </label>
                <a href="/auth/forgot-password" class="forgot-password">Forgot password?</a>
            </div>

            <button type="submit" class="btn-submit" id="loginBtn">
                <span class="btn-text">Sign In</span>
                <span class="btn-loader" style="display: none;">⏳</span>
            </button>
        </form>

        <!-- Social Login -->
        <div class="social-registration">
            <div class="divider">
                <span>or continue with</span>
            </div>
            
            <div class="social-buttons">
                <button type="button" class="social-btn google" onclick="socialLogin('google')">
                    <img src="https://www.google.com/favicon.ico" alt="Google" />
                    Google
                </button>
                <button type="button" class="social-btn apple" onclick="socialLogin('apple')">
                    <span class="apple-icon"></span>
                    Apple
                </button>
                <button type="button" class="social-btn facebook" onclick="socialLogin('facebook')">
                    <span class="facebook-icon">f</span>
                    Facebook
                </button>
            </div>
        </div>

        <!-- Register Link -->
        <div class="auth-footer">
            <p>Don't have an account? <a href="/auth/register@(Model?.ReturnUrl != null ? "?returnUrl=" + Model.ReturnUrl : "")">Create free account</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle password visibility
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
        }

        // Social login handlers
        function socialLogin(provider) {
            window.location.href = `/auth/external-login?provider=${provider}&returnUrl=@(Model?.ReturnUrl)`;
        }

        // Form submission with loading state
        document.getElementById('loginForm')?.addEventListener('submit', function(e) {
            const btn = document.getElementById('loginBtn');
            const btnText = btn.querySelector('.btn-text');
            const btnLoader = btn.querySelector('.btn-loader');
            
            btnText.style.display = 'none';
            btnLoader.style.display = 'inline';
            btn.disabled = true;
        });

        // Auto-dismiss alerts after 5 seconds
        document.querySelectorAll('.alert-dismissible').forEach(alert => {
            setTimeout(() => {
                if (alert && alert.parentElement) {
                    alert.style.animation = 'slideOut 0.3s ease-out';
                    setTimeout(() => alert.remove(), 300);
                }
            }, 5000);
        });

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideOut {
                from {
                    opacity: 1;
                    transform: translateX(0);
                }
                to {
                    opacity: 0;
                    transform: translateX(100%);
                }
            }
        `;
        document.head.appendChild(style);
    </script>
}